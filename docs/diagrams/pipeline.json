  "cards": [
    {
      "dot": "cyan",
      "title": "Where the pieces live",
      "items": [
        "Each step writes into work/<video id>/",
        "info.json, transcript.json, analysis.json, frames and clips",
        "A step that already ran is not run again unless you say Thorough"
      ]
    },
    {
      "dot": "emerald",
      "title": "Every step is also a command",
      "items": [
        "video-tldr fetch, transcribe, analyze, enrich, frames, render",
        "video-tldr run does all six in a row",
        "So a failing step can be repeated on its own, without the browser"
      ]
    },
    {
      "dot": "amber",
      "title": "What reaches a language model",
      "items": [
        "analyze: the transcript",
        "enrich: the README of a linked repository",
        "frames: the pictures, to label them"
      ]
