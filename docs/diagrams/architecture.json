    {
      "dot": "cyan",
      "title": "The extension",
      "items": [
        "Reads the tab URL only when you click",
        "Asks once for access to 127.0.0.1",
        "The worker outlives the popup and polls the job"
      ]
    },
    {
      "dot": "emerald",
      "title": "The service",
      "items": [
        "Every step is also a command line call",
        "One job at a time, the next one queues",
        "Never reachable from a web page: Host and Origin are checked"
      ]
    },
    {
      "dot": "amber",
      "title": "What crosses the line",
      "items": [
        "YouTube, for the video and its captions",
