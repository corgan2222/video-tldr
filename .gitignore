# Language-specific entries -- build artefacts, caches, the compiled binary --
# are appended by the project setup; nothing is guessed here in advance.
# Whatever CI builds from the tag is attached to the release there and never
# travels through a commit.

# TypeScript
/node_modules
/dist
npm-debug.log*
website/node_modules
website/.next
website/out
website/.source

# Python (service/)
__pycache__/
*.pyc
.venv/
service/dist
*.egg-info/
.pytest_cache/
.ruff_cache/

# The service's own data directory, when VIDEO_TLDR_HOME points inside the
# checkout: config.json carries API keys, models/ runs to ten gigabytes.
/data/

# One zip per store, built by scripts/package.py. What CI builds from the
# tag is attached to the release, never committed.
/packages
/.lint
